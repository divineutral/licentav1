  <DataSources>
    <DataSource Name="DS_Agsis">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=YOUR_SERVER;Initial Catalog=AGSIS</ConnectString>
        <Prompt>Specify a user name and password for data source DS_Agsis:</Prompt>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>40b71616-2a81-4d97-a7be-3edabe8584a6</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet_StatFunctii">
      <Query>
        <DataSourceName>DS_Agsis</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@AnUniv">
            <Value>=Parameters!AnUniv.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@specializare">
            <Value>=Parameters!specializare.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 
    CASE WHEN ppm.TitularSauSuplinitor = 1 THEN 'Titular' ELSE 'Suplinitor/PO' END AS TipPost,
    SUM(CASE WHEN ppm.TitularSauSuplinitor = 1 AND ppm.ID_Profesor IS NOT NULL THEN 1 ELSE 0 END) AS TitularOcupate,
    SUM(CASE WHEN ppm.TitularSauSuplinitor = 0 THEN 1 ELSE 0 END) AS PlataOra,
    SUM(CASE WHEN ppm.ID_Profesor IS NULL THEN 1 ELSE 0 END) AS Vacante,
    COUNT(*) AS Total
FROM [agsis_dw].[dbo].[Post_Profesor_Materie] ppm
INNER JOIN [agsis_dw].[dbo].[Cazare] cz ON ppm.ID_AnUniv = cz.ID_AnUniv
WHERE UPPER(LTRIM(RTRIM(REPLACE(cz.DenumireAnUniv, CHAR(9), '')))) = UPPER(LTRIM(RTRIM(@AnUniv)))
  AND UPPER(LTRIM(RTRIM(REPLACE(ppm.DenumireSpecializare, CHAR(9), '')))) LIKE '%' + UPPER(LTRIM(RTRIM(@specializare))) + '%'
GROUP BY ppm.TitularSauSuplinitor</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="TipPost">
          <DataField>TipPost</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TitularOcupate">
          <DataField>TitularOcupate</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PlataOra">
          <DataField>PlataOra</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Vacante">
          <DataField>Vacante</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Total">
          <DataField>Total</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet_Specializari">
      <Query>
        <DataSourceName>DS_Agsis</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@facultate">
            <Value>=Parameters!facultate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="specializare">
            <Value>specializare</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT 
    UPPER(LTRIM(RTRIM(REPLACE(DenumireSpecializare, CHAR(9), '')))) AS DenumireCurata
FROM [agsis_dw].[dbo].[View_Student_Bursa_AnUniv_Semestru]
WHERE DenumireFacultate = @facultate
  AND DenumireSpecializare IS NOT NULL
  AND DenumireSpecializare NOT LIKE '%+%'
ORDER BY DenumireCurata</CommandText>
      </Query>
      <Fields>
        <Field Name="DenumireCurata">
          <DataField>DenumireCurata</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Dataset_Facultati">
      <Query>
        <DataSourceName>DS_Agsis</DataSourceName>
        <CommandText>SELECT DISTINCT Denumire 
FROM [agsis_dw].[dbo].[facultate] 
WHERE Denumire LIKE 'Facultatea de%' 
OR Denumire IN ('FACULTATEA DE DREPT', 'FACULTATEA DE MEDICINĂ', 'FACULTATEA DE MUZICA')
ORDER BY Denumire</CommandText>
      </Query>
      <Fields>
        <Field Name="Denumire">
          <DataField>Denumire</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet_Nou">
      <Query>
        <DataSourceName>DS_Agsis</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@facultate">
            <Value>=Parameters!facultate.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@specializare">
            <Value>=Parameters!specializare.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 
    DenumireFacultate AS Facultate,
    DenumireSpecializare AS Specializare,
    NumeIntreg AS Profesor,
    DenumireGradDidacticPost AS DenumirePost,
    CASE 
        WHEN ID_Profesor IS NULL THEN 'Vacant'
        WHEN TitularSauSuplinitor = 1 THEN 'Ocupat - Titular'
        ELSE 'Ocupat - Suplinitor/PO'
    END AS StatusPost
FROM [agsis_dw].[dbo].[Post_Profesor_Materie]
WHERE DenumireFacultate = @facultate
AND UPPER(LTRIM(RTRIM(DenumireSpecializare))) = UPPER(LTRIM(RTRIM(@specializare)))</CommandText>
      </Query>
      <Fields>
        <Field Name="Facultate">
          <DataField>Facultate</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Specializare">
          <DataField>Specializare</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Profesor">
          <DataField>Profesor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DenumirePost">
          <DataField>DenumirePost</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="StatusPost">
          <DataField>StatusPost</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Dataset_AniUniv">
      <Query>
        <DataSourceName>DS_Agsis</DataSourceName>
        <CommandText>SELECT DISTINCT 
    UPPER(LTRIM(RTRIM(REPLACE(DenumireAnUniv, CHAR(9), '')))) AS DenumireAnUniv
FROM [agsis_dw].[dbo].[Cazare]
WHERE DenumireAnUniv IS NOT NULL

UNION

SELECT 'AN UNIVERSITAR 2025-2026'
ORDER BY DenumireAnUniv DESC</CommandText>
      </Query>
      <Fields>
        <Field Name="DenumireAnUniv">
          <DataField>DenumireAnUniv</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
