  <DataSources>
    <DataSource Name="NormaCadreDidactice">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=YOUR_SERVER;Initial Catalog=agsis_dw</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>b2d8d7a1-556f-4ea7-8f08-13b638ee0a7b</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet_Norma">
      <Query>
        <DataSourceName>NormaCadreDidactice</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@AnUniv">
            <Value>=Parameters!AnUniv.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Facultate">
            <Value>=Parameters!facultate.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@Specializare">
            <Value>=Parameters!specializare.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Profesor">
            <Value>=Parameters!profesor.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH DateNormalizate AS (
    SELECT 
        ppm.NumeIntreg,
        sf.DenumireMaterie,
        ISNULL(sf.NrSemestruDinAn, 0) AS Semestru,
        ISNULL(sf.TitularSauSuplinitor, 0) AS TitularSauSuplinitor,
        sf.Nr_Ore_Curs, 
        sf.Nr_Ore_Seminar, 
        sf.Nr_Ore_Laborator,
        -- LOGICA DE CURATARE CENTRALIZATA
        UPPER(LTRIM(RTRIM(REPLACE(REPLACE(
            CASE 
                WHEN CHARINDEX('+', sf.DenumireSpecializare) &gt; 0 
                THEN LEFT(sf.DenumireSpecializare, CHARINDEX('+', sf.DenumireSpecializare) - 1)
                ELSE sf.DenumireSpecializare 
            END, 
        'Ș', 'S'), 'Ț', 'T')))) AS SpecializareCurata
    FROM [AGSIS].[pi].[StatDeFunctiiPeSpecializare] sf
    INNER JOIN [agsis_dw].[dbo].[Post_Profesor_Materie] ppm 
        ON sf.ID_Post_Profesor_Materie = ppm.ID_Post_Profesor_Materie
    INNER JOIN [agsis_dw].[dbo].[Cazare] cz
        ON ppm.ID_AnUniv = cz.ID_AnUniv
    WHERE 
        -- Filtrare AN UNIVERSITAR
        (@AnUniv = 'Toti' OR UPPER(LTRIM(RTRIM(REPLACE(cz.DenumireAnUniv, CHAR(9), '')))) = @AnUniv)
)
SELECT 
    NumeIntreg AS Profesor,
    DenumireMaterie AS Materie,
    SpecializareCurata,
    Semestru,
    TitularSauSuplinitor,
    SUM(ISNULL(Nr_Ore_Curs, 0) + ISNULL(Nr_Ore_Seminar, 0) + ISNULL(Nr_Ore_Laborator, 0)) AS Norma
FROM DateNormalizate
WHERE 
    -- Filtrare SPECIALIZARE (Clean match)
    (N'Toti' IN (@Specializare) OR SpecializareCurata IN (@Specializare))
    AND 
    -- Filtrare PROFESOR
    (N'Toti' IN (@Profesor) OR NumeIntreg IN (@Profesor))
GROUP BY 
    NumeIntreg, 
    DenumireMaterie, 
    SpecializareCurata, 
    Semestru, 
    TitularSauSuplinitor
ORDER BY Profesor ASC</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Profesor">
          <DataField>Profesor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Materie">
          <DataField>Materie</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SpecializareCurata">
          <DataField>SpecializareCurata</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Semestru">
          <DataField>Semestru</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Norma">
          <DataField>Norma</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TitularSauSuplinitor">
          <DataField>TitularSauSuplinitor</DataField>
          <rd:TypeName>System.Byte</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet_Facultati">
      <Query>
        <DataSourceName>NormaCadreDidactice</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@AnUniv">
            <Value>=Parameters!AnUniv.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 'Toti' AS FacultateCurata, 0 AS Ordine
UNION ALL
SELECT DISTINCT 
    UPPER(LTRIM(RTRIM(REPLACE(REPLACE(REPLACE(ppm.DenumireFacultate, CHAR(9), ''), 'Ș', 'S'), 'Ț', 'T')))) AS FacultateCurata,
    1 AS Ordine
FROM [agsis_dw].[dbo].[Post_Profesor_Materie] ppm
INNER JOIN [agsis_dw].[dbo].[Cazare] cz 
    ON ppm.ID_AnUniv = cz.ID_AnUniv
WHERE ppm.DenumireFacultate IS NOT NULL
  -- Legatura cu parametrul AnUniv pentru a arata doar facultatile din anul ales
  AND (@AnUniv = 'Toti' OR UPPER(LTRIM(RTRIM(REPLACE(cz.DenumireAnUniv, CHAR(9), '')))) = @AnUniv)
ORDER BY Ordine, FacultateCurata</CommandText>
      </Query>
      <Fields>
        <Field Name="FacultateCurata">
          <DataField>FacultateCurata</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Ordine">
          <DataField>Ordine</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet_Specializari">
      <Query>
        <DataSourceName>NormaCadreDidactice</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@facultate">
            <Value>=Parameters!facultate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@AnUniv">
            <Value>=Parameters!AnUniv.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 'Toti' AS SpecializareCurata, 0 AS Ordine
UNION ALL
SELECT DISTINCT 
    -- Curatare specializare
    UPPER(LTRIM(RTRIM(REPLACE(REPLACE(
        CASE 
            WHEN CHARINDEX('+', ppm.DenumireSpecializare) &gt; 0 
            THEN LEFT(ppm.DenumireSpecializare, CHARINDEX('+', ppm.DenumireSpecializare) - 1)
            ELSE ppm.DenumireSpecializare 
        END, 
    'Ș', 'S'), 'Ț', 'T')))) AS SpecializareCurata, 
    1 AS Ordine
FROM [agsis_dw].[dbo].[Post_Profesor_Materie] ppm
INNER JOIN [agsis_dw].[dbo].[Cazare] cz 
    ON ppm.ID_AnUniv = cz.ID_AnUniv
WHERE 
    ppm.DenumireSpecializare IS NOT NULL
    AND
    -- MODIFICARE AICI: Folosim IN in loc de = pentru Facultate
    (N'Toti' IN (@facultate) OR 
     UPPER(LTRIM(RTRIM(REPLACE(REPLACE(REPLACE(ppm.DenumireFacultate, CHAR(9), ''), 'Ș', 'S'), 'Ț', 'T')))) IN (@facultate)
    )
    AND
    -- MODIFICARE AICI: Folosim IN si pentru AnUniv (preventiv)
    (N'Toti' IN (@AnUniv) OR UPPER(LTRIM(RTRIM(REPLACE(cz.DenumireAnUniv, CHAR(9), '')))) IN (@AnUniv))
ORDER BY Ordine, SpecializareCurata</CommandText>
      </Query>
      <Fields>
        <Field Name="SpecializareCurata">
          <DataField>SpecializareCurata</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Ordine">
          <DataField>Ordine</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet_Profesori">
      <Query>
        <DataSourceName>NormaCadreDidactice</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@AnUniv">
            <Value>=Parameters!AnUniv.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@facultate">
            <Value>=Parameters!facultate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@specializare">
            <Value>=Parameters!specializare.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 'Toti' AS NumeIntreg, 0 AS Ordine
UNION ALL
SELECT DISTINCT 
    ppm.NumeIntreg, 
    1 AS Ordine
FROM [AGSIS].[pi].[StatDeFunctiiPeSpecializare] sf
INNER JOIN [agsis_dw].[dbo].[Post_Profesor_Materie] ppm 
    ON sf.ID_Post_Profesor_Materie = ppm.ID_Post_Profesor_Materie
INNER JOIN [agsis_dw].[dbo].[Cazare] cz 
    ON ppm.ID_AnUniv = cz.ID_AnUniv
WHERE 
   -- 1. Filtrare dupa AN (Acum folosim IN)
   (N'Toti' IN (@AnUniv) OR UPPER(LTRIM(RTRIM(REPLACE(cz.DenumireAnUniv, CHAR(9), '')))) IN (@AnUniv))
   AND
   -- 2. Filtrare dupa FACULTATE (Acum folosim IN)
   (N'Toti' IN (@facultate) OR 
    UPPER(LTRIM(RTRIM(REPLACE(REPLACE(REPLACE(ppm.DenumireFacultate, CHAR(9), ''), 'Ș', 'S'), 'Ț', 'T')))) IN (@facultate)
   )
   AND
   -- 3. Filtrare dupa SPECIALIZARE (Deja folosea IN, dar e bine de verificat)
   (N'Toti' IN (@specializare) OR 
    UPPER(LTRIM(RTRIM(REPLACE(REPLACE(
        CASE 
            WHEN CHARINDEX('+', sf.DenumireSpecializare) &gt; 0 
            THEN LEFT(sf.DenumireSpecializare, CHARINDEX('+', sf.DenumireSpecializare) - 1)
            ELSE sf.DenumireSpecializare 
        END, 
    'Ș', 'S'), 'Ț', 'T')))) IN (@specializare)
   )
ORDER BY Ordine, NumeIntreg</CommandText>
      </Query>
      <Fields>
        <Field Name="NumeIntreg">
          <DataField>NumeIntreg</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Ordine">
          <DataField>Ordine</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Dataset_AniUniv">
      <Query>
        <DataSourceName>NormaCadreDidactice</DataSourceName>
        <CommandText>SELECT 'Toti' AS DenumireAnUniv, 0 AS Ordine
UNION ALL
SELECT DISTINCT 
    UPPER(LTRIM(RTRIM(REPLACE(DenumireAnUniv, CHAR(9), '')))) AS DenumireAnUniv,
    1 AS Ordine
FROM [agsis_dw].[dbo].[Cazare]
WHERE DenumireAnUniv IS NOT NULL
UNION ALL
SELECT 'AN UNIVERSITAR 2025-2026', 1 -- Fallback-ul tau
ORDER BY Ordine, DenumireAnUniv DESC</CommandText>
      </Query>
      <Fields>
        <Field Name="DenumireAnUniv">
          <DataField>DenumireAnUniv</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Ordine">
          <DataField>Ordine</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
