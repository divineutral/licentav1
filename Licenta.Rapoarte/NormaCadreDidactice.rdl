  <DataSources>
    <DataSource Name="NormaCadreDidactice">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=YOUR_SERVER;Initial Catalog=agsis_dw</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>b2d8d7a1-556f-4ea7-8f08-13b638ee0a7b</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet_Norma">
      <Query>
        <DataSourceName>NormaCadreDidactice</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Specializare">
            <Value>=Parameters!Specializare.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@facultate">
            <Value>=Parameters!facultate.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@Profesor">
            <Value>=Parameters!Profesor.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@AnUniv">
            <Value>=Parameters!AnUniv.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH DateNormalizate AS (
    SELECT 
        ppm.NumeIntreg,
        sf.DenumireMaterie,
        ISNULL(sf.NrSemestruDinAn, 0) AS Semestru,
        ISNULL(sf.TitularSauSuplinitor, 0) AS TitularSauSuplinitor,
        sf.Nr_Ore_Curs, 
        sf.Nr_Ore_Seminar, 
        sf.Nr_Ore_Laborator,
        -- Curățare și normalizare
        UPPER(LTRIM(RTRIM(REPLACE(REPLACE(
            CASE 
                WHEN CHARINDEX('+', sf.DenumireSpecializare) &gt; 0 
                THEN LEFT(sf.DenumireSpecializare, CHARINDEX('+', sf.DenumireSpecializare) - 1)
                ELSE sf.DenumireSpecializare 
            END, 
        'Ș', 'S'), 'Ț', 'T')))) AS SpecializareCurata
    FROM [AGSIS].[pi].[StatDeFunctiiPeSpecializare] sf
    INNER JOIN [agsis_dw].[dbo].[Post_Profesor_Materie] ppm 
        ON sf.ID_Post_Profesor_Materie = ppm.ID_Post_Profesor_Materie
)
SELECT 
    NumeIntreg AS Profesor,
    DenumireMaterie AS Materie,
    SpecializareCurata,
    Semestru,
    TitularSauSuplinitor,
    SUM(ISNULL(Nr_Ore_Curs, 0) + ISNULL(Nr_Ore_Seminar, 0) + ISNULL(Nr_Ore_Laborator, 0)) AS Norma
FROM DateNormalizate
WHERE 
    -- ACEASTA ESTE FILTRAREA CORECTĂ
    (N'Toti' IN (@Specializare) OR SpecializareCurata IN (@Specializare))
    AND 
    (N'Toti' IN (@Profesor) OR NumeIntreg IN (@Profesor))
GROUP BY 
    NumeIntreg, 
    DenumireMaterie, 
    SpecializareCurata, 
    Semestru, 
    TitularSauSuplinitor
ORDER BY Profesor ASC</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Profesor">
          <DataField>Profesor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Materie">
          <DataField>Materie</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SpecializareCurata">
          <DataField>SpecializareCurata</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Semestru">
          <DataField>Semestru</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Norma">
          <DataField>Norma</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TitularSauSuplinitor">
          <DataField>TitularSauSuplinitor</DataField>
          <rd:TypeName>System.Byte</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet_Facultati">
      <Query>
        <DataSourceName>NormaCadreDidactice</DataSourceName>
        <CommandText>SELECT 'Toti' AS FacultateCurata, 0 AS Ordine
UNION ALL
SELECT DISTINCT 
    UPPER(LTRIM(RTRIM(REPLACE(REPLACE(REPLACE(DenumireFacultate, 'Facultatea de ', ''), 'Ș', 'S'), 'Ț', 'T')))) AS FacultateCurata,
    1 AS Ordine
FROM [agsis_dw].[dbo].[Post_Profesor_Materie]
ORDER BY Ordine, FacultateCurata ASC</CommandText>
      </Query>
      <Fields>
        <Field Name="FacultateCurata">
          <DataField>FacultateCurata</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Ordine">
          <DataField>Ordine</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet_Specializari">
      <Query>
        <DataSourceName>NormaCadreDidactice</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@facultate">
            <Value>=Parameters!facultate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 'Toti' AS SpecializareCurata, 0 AS Ordine
UNION ALL
SELECT DISTINCT 
    UPPER(LTRIM(RTRIM(REPLACE(REPLACE(
        CASE 
            WHEN CHARINDEX('+', DenumireSpecializare) &gt; 0 
            THEN LEFT(DenumireSpecializare, CHARINDEX('+', DenumireSpecializare) - 1)
            ELSE DenumireSpecializare 
        END, 
    'Ș', 'S'), 'Ț', 'T')))) AS SpecializareCurata, 
    1 AS Ordine
FROM [agsis_dw].[dbo].[Post_Profesor_Materie]
WHERE (@facultate = 'Toti' OR DenumireFacultate LIKE '%' + @facultate + '%')
ORDER BY Ordine, SpecializareCurata ASC</CommandText>
      </Query>
      <Fields>
        <Field Name="SpecializareCurata">
          <DataField>SpecializareCurata</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Ordine">
          <DataField>Ordine</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet_Profesori">
      <Query>
        <DataSourceName>NormaCadreDidactice</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Specializare">
            <Value>=Parameters!specializare.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 'Toti' AS NumeIntreg, 0 AS Ordine
UNION ALL
SELECT DISTINCT ppm.NumeIntreg, 1 AS Ordine
FROM [AGSIS].[pi].[StatDeFunctiiPeSpecializare] sf
INNER JOIN [agsis_dw].[dbo].[Post_Profesor_Materie] ppm 
    ON sf.ID_Post_Profesor_Materie = ppm.ID_Post_Profesor_Materie
WHERE 
   -- AICI ERA PROBLEMA: Folosim IN acum, compatibil cu selecția multiplă
   (N'Toti' IN (@Specializare) OR 
    UPPER(LTRIM(RTRIM(REPLACE(REPLACE(
        CASE 
            WHEN CHARINDEX('+', sf.DenumireSpecializare) &gt; 0 
            THEN LEFT(sf.DenumireSpecializare, CHARINDEX('+', sf.DenumireSpecializare) - 1)
            ELSE sf.DenumireSpecializare 
        END, 
    'Ș', 'S'), 'Ț', 'T')))) IN (@Specializare)
   )
ORDER BY Ordine, NumeIntreg ASC</CommandText>
      </Query>
      <Fields>
        <Field Name="NumeIntreg">
          <DataField>NumeIntreg</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Ordine">
          <DataField>Ordine</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Dataset_AniUniv">
      <Query>
        <DataSourceName>NormaCadreDidactice</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@AnUniv">
            <Value>@AnUniv</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT 
    UPPER(LTRIM(RTRIM(REPLACE(DenumireAnUniv, CHAR(9), '')))) AS DenumireAnUniv
FROM [agsis_dw].[dbo].[Cazare]
WHERE DenumireAnUniv IS NOT NULL

UNION

SELECT 'AN UNIVERSITAR 2025-2026'
ORDER BY DenumireAnUniv DESC</CommandText>
      </Query>
      <Fields>
        <Field Name="DenumireAnUniv">
          <DataField>DenumireAnUniv</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
