                                  <Value>="Sem. 1: " &amp; Sum(IIF(CInt(Fields!Semestru.Value) = 1 AND CInt(Fields!TitularSauSuplinitor.Value) = 1, CDbl(Fields!Norma.Value), 0.0)) &amp; " h Titular | " &amp;
 Sum(IIF(CInt(Fields!Semestru.Value) = 1 AND CInt(Fields!TitularSauSuplinitor.Value) = 0, CDbl(Fields!Norma.Value), 0.0)) &amp; " h P/O" &amp; vbCrLf &amp;
 "Sem. 2: " &amp; Sum(IIF(CInt(Fields!Semestru.Value) = 2 AND CInt(Fields!TitularSauSuplinitor.Value) = 1, CDbl(Fields!Norma.Value), 0.0)) &amp; " h Titular | " &amp;
 Sum(IIF(CInt(Fields!Semestru.Value) = 2 AND CInt(Fields!TitularSauSuplinitor.Value) = 0, CDbl(Fields!Norma.Value), 0.0)) &amp; " h P/O"</Value>
